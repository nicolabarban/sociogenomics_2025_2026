head(EAgwasResults)
dim(EAgwasResults)
names(EAgwasResults)
EAgwasResults_sub<-subset(EAgwasResults, P<0.0005)
dim(EAgwasResults_sub)
install.packages("manhattanly")
library(manhattanly)
help(manhattanly)
manhattanly(EAgwasResults_sub, snp = "rsID" , bp="BP", p="P", chr="Chr")
qq(EAgwasResults_sub$P)
install.packages("qqman")
library(qqman)
qq(EAgwasResults_sub$P)
hits<-EAgwasResults_sub[EAgwasResults_sub$P<5e-50,]
EAgwasResults_sub$highlight.snps<-0
for ( i in 1: dim(hits)[1]){
chr<-as.numeric(hits[i,4])
loc_min<- as.numeric(hits[i, 5]-5000)
loc_max<- as.numeric(hits[i, 5]+5000)
neighbours.snps<- EAgwasResults_sub$rsID[EAgwasResults_sub$Chr==chr & EAgwasResults_sub$BP>loc_min & EAgwasResults_sub$BP<loc_max]
EAgwasResults_sub$highlight.snps[EAgwasResults_sub$rsID %in% neighbours.snps] <- 1
}
hits<-EAgwasResults_sub[EAgwasResults_sub$P<5e-8,]
EAgwasResults_sub$highlight.snps<-0
for ( i in 1: dim(hits)[1]){
chr<-as.numeric(hits[i,4])
loc_min<- as.numeric(hits[i, 5]-5000)
loc_max<- as.numeric(hits[i, 5]+5000)
neighbours.snps<- EAgwasResults_sub$rsID[EAgwasResults_sub$Chr==chr & EAgwasResults_sub$BP>loc_min & EAgwasResults_sub$BP<loc_max]
EAgwasResults_sub$highlight.snps[EAgwasResults_sub$rsID %in% neighbours.snps] <- 1
}
library(data.table)
# Convert to data.table and create ranges
DT <- as.data.table(EAgwasResults_sub)
hits <- DT[P < 5e-8, .(Chr, start = BP - 1000, end = BP + 1000)]
# Add SNP info as intervals
DT[, `:=`(start = BP, end = BP)]
# Prepare both for foverlaps
setkey(DT, Chr, start, end)
setkey(hits, Chr, start, end)
# Mark overlapping SNPs
DT[, highlight.snps := 0]
DT[foverlaps(DT, hits, nomatch = 0L), highlight.snps := 1]
manhattan(DT,
chr="Chr",
bp="BP",
snp="rsID",
p="P",
highlight=EAgwasResults_sub$rsID[EAgwasResults_sub$highlight.snps==1],
suggestiveline=F)
hits
DT
library(data.table)
# Convert to data.table
DT <- as.data.table(EAgwasResults_sub)
hits <- DT[P < 5e-8]
# Initialize highlight column
DT[, highlight.snps := 0]
# Set keys for fast range joins
setkey(DT, Chr, BP)
# For each hit, mark neighbors
for (i in seq_len(nrow(hits))) {
chr <- hits[i, Chr]
pos <- hits[i, BP]
DT[Chr == chr & BP >= (pos - 1000) & BP <= (pos + 1000), highlight.snps := 1]
}
